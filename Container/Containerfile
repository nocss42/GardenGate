FROM ubuntu:26.04

# Main port
EXPOSE 25200/tcp
EXPOSE 25200/udp

# Fallback port
EXPOSE 27200/tcp
EXPOSE 27200/udp

# Env vars
ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_TERM_COLOR=always
ENV GAMEID=umu-gardengate
ENV MAXIMA_UMU_GAMEID=umu-gardengate
ENV GG_CONSOLE=1
#ENV GG_LOG=Dedicated
ENV GG_LOG_LEVEL=Debug
ENV MAXIMA_LOG_LEVEL=debug
ENV MAXIMA_DISABLE_QRC=1
ENV MAXIMA_FORCE_INSTALL=1
ENV MAXIMA_UMU_PROTONPATH="/home/maxima/.local/share/Steam/compatibilitytools.d/Proton-CachyOS Latest/"
#ENV MAXIMA_DISABLE_WINE_VERIFICATION=1
#ENV MAXIMA_WINE_COMMAND="/usr/bin/wine"

# Proton stuff
ENV PROTONPATH="/home/maxima/.local/share/Steam/compatibilitytools.d/Proton-CachyOS Latest/"
ENV PROTON_ENABLE_WAYLAND=1
#ENV PROTON_USE_WINED3D=1
#ENV PROTON_USE_NTSYNC=1
#ENV PROTON_NO_ESYNC=1

# Display server stuff
#ENV WAYLAND_DISPLAY=wayland-1
#ENV DISPLAY=:99
#ENV SDL_VIDEODRIVER=x11
#ENV GDK_BACKEND=x11
#ENV LIBGL_ALWAYS_SOFTWARE=1
#ENV LIBGL_DRI3_DISABLE=1

# Dependencies
RUN dpkg --add-architecture i386
RUN apt-get update && apt-get install -y \
    sudo \
    vim \
    git \
    btop \
    curl \
    wget \
    locales \
    xdg-utils \
    zenity \
    gnupg2 \
    winbind \
    cage \
    wtype \
    xwayland-run \
    ca-certificates \
    tar \
    xz-utils \
    unzip \
    lib32gcc-s1 \
    lib32stdc++6 \
    libc6-i386

# umu
RUN set -eux; \
    ver="$( \
      curl -sIL https://github.com/Open-Wine-Components/umu-launcher/releases/latest \
      | grep -i '^location:' \
      | sed -E 's|.*tag/||' \
      | tr -d '\r' \
    )"; \
    curl -Lo /tmp/umu-launcher.deb \
      "https://github.com/Open-Wine-Components/umu-launcher/releases/download/${ver}/python3-umu-launcher_${ver}-1_amd64_ubuntu-resolute.deb"; \
    apt-get install -y /tmp/umu-launcher.deb; \
    rm -f /tmp/umu-launcher.deb;

# Install maxima
RUN curl -L -o /tmp/linux.zip \
      https://github.com/sjp761/maxima/releases/latest/download/linux.zip \
    && unzip -j /tmp/linux.zip maxima-cli maxima-bootstrap -d /tmp/ \
    && install -Dm755 /tmp/maxima-cli /tmp/maxima-bootstrap -t /usr/local/bin/ \
    && rm -f /tmp/linux.zip /tmp/maxima-cli /tmp/maxima-bootstrap

# Create user
RUN useradd -m -s /bin/bash maxima

# Give maxima sudo without password
RUN echo "maxima ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/maxima \
 && chmod 0440 /etc/sudoers.d/maxima

USER maxima

# aliases
RUN echo "alias btop='btop --force-utf'" >> $HOME/.bashrc
RUN echo "alias kill_exe='sudo pkill -9 -f "\\.exe"'" >> $HOME/.bashrc

# Create the required dirs
RUN mkdir -p \
    "$HOME/.cache" \
    "$HOME/.config/protonfixes/localfixes" \
    "$HOME/.local/share/applications" \
    "$HOME/.local/share/maxima/wine/umu" \
    "$HOME/.local/share/Steam/compatibilitytools.d" \
    "$HOME/Games" \
    "$HOME/Games/gw1" \
    "$HOME/Games/gw1_pfx" \
    "$HOME/Games/gw2" \
    "$HOME/Games/gw2_pfx" \
    "$HOME/Games/bfn" \
    "$HOME/Games/bfn_pfx"

# ProtonPlus & proton-CachyOS (steam dlls are generated bc protonplus checks for their existence)
# ge-proton related issue https://github.com/GloriousEggroll/proton-ge-custom/issues/901
RUN set -eux; \
    mkdir -p "$HOME/AppImages" \
        "$HOME/.local/share/Steam/compatibilitytools.d/"; \
    touch "$HOME/.local/share/Steam/steamclient.dll" \
        "$HOME/.local/share/Steam/steamclient64.dll"; \
    ver="$( \
        curl -sIL https://github.com/Vysp3r/ProtonPlus/releases/latest \
        | grep -i '^location:' \
        | sed -E 's|.*/tag/||' \
        | tr -d '\r' \
    )"; \
    curl -fL -o "$HOME/AppImages/ProtonPlus.AppImage" \
        "https://github.com/Vysp3r/ProtonPlus/releases/download/${ver}/ProtonPlus-${ver#v}-anylinux-x86_64.AppImage"; \
    chmod +x "$HOME/AppImages/ProtonPlus.AppImage"; \
    "$HOME/AppImages/ProtonPlus.AppImage" install steam-system proton-cachyos latest

# Script
COPY --chown=maxima:maxima --chmod=755 maxima.sh /home/maxima/maxima.sh

# auth.toml
COPY --chown=maxima:maxima auth.toml /home/maxima/.local/share/maxima/auth.toml

# regedit
#COPY --chown=maxima:maxima regs/*.reg /home/maxima/

# protonfix
COPY --chown=maxima:maxima ./localfixes/umu-gardengate.py /home/maxima/.config/protonfixes/localfixes/

# init proton/steamrt
RUN umu-run wineboot -u

WORKDIR /home/maxima/Games
